<div class="auth-page">

  <div class="auth-card">

<div class="auth-header">
  <h1>Criar conta</h1>
  <p>Crie sua conta gratuitamente no Askly.</p>
</div>

<%= form_for(resource,
             as: resource_name,
             url: registration_path(resource_name)) do |f| %>

  <% if resource.errors.any? %>
    <div class="auth-error">
      <% resource.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :email, "E-mail" %>

    <%= f.email_field :email,
        autofocus: true,
        autocomplete: "email",
        placeholder: "seu@email.com" %>
  </div>

  <div class="form-group">
    <%= f.label :password, "Senha" %>

    <%= f.password_field :password,
        autocomplete: "new-password",
        placeholder: "Crie uma senha" %>

    <% if @minimum_password_length %>
      <small>
        Mínimo de <%= @minimum_password_length %> caracteres.
      </small>
    <% end %>
  </div>

  <div class="form-group">
    <%= f.label :password_confirmation, "Confirmar senha" %>

    <%= f.password_field :password_confirmation,
        autocomplete: "new-password",
        placeholder: "Digite a senha novamente" %>
  </div>

  <div class="auth-submit">
    <%= f.submit "Criar minha conta",
        class: "submit-answer-button" %>
  </div>

<% end %>

<div class="auth-links">

  <%= link_to "Já tenho uma conta",
              new_session_path(resource_name) %>

</div>

  </div>

</div>
