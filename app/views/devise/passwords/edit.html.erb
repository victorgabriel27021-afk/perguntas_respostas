<div class="auth-page">

  <div class="auth-card">

    <div class="auth-header">
      <h1><%= t("devise_passwords_edit.title") %></h1>
      <p><%= t("devise_passwords_edit.description") %></p>
    </div>

    <%= form_for(resource,
                 as: resource_name,
                 url: password_path(resource_name),
                 html: { method: :put }) do |f| %>

      <%= f.hidden_field :reset_password_token %>

      <div class="form-group">
        <%= f.label :password, t("devise_passwords_edit.new_password") %>

        <%= f.password_field :password,
            autofocus: true,
            autocomplete: "new-password",
            placeholder: t("devise_passwords_edit.new_password_placeholder") %>

        <% if @minimum_password_length %>
          <small>
            <%= t("devise_passwords_edit.minimum_password_length",
                  count: @minimum_password_length) %>
          </small>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation,
            t("devise_passwords_edit.confirm_password") %>

        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            placeholder: t("devise_passwords_edit.confirm_password_placeholder") %>
      </div>

      <div class="auth-submit">
        <%= f.submit t("devise_passwords_edit.submit"),
            class: "submit-answer-button" %>
      </div>

    <% end %>

    <div class="auth-links">

      <%= link_to t("devise_passwords_edit.back_to_login"),
                  new_session_path(resource_name) %>

    </div>

  </div>

</div>