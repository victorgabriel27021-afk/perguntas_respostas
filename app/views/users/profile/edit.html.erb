<div class="profile-page">

  <div class="profile-card">


<h1>Meu perfil</h1>

<p class="profile-description">
  Atualize seus dados pessoais.
</p>

<%= form_with model: current_user,
              url: users_profile_path,
              method: :patch do |form| %>

  <div class="form-group">
  <%= form.label :avatar, "Foto de perfil" %>
  <%= form.file_field :avatar %>
</div>

  <div class="profile-form-grid">

    <div class="form-group">
      <%= form.label :first_name, "Nome" %>
      <%= form.text_field :first_name %>
    </div>

    <div class="form-group">
      <%= form.label :last_name, "Sobrenome" %>
      <%= form.text_field :last_name %>
    </div>

    <div class="form-group">
      <%= form.label :phone, "Telefone" %>
      <%= form.telephone_field :phone %>
    </div>

    <div class="form-group">
      <%= form.label :birth_date, "Data de nascimento" %>
      <%= form.date_field :birth_date %>
    </div>

    <div class="form-group">
      <%= form.label :city, "Cidade" %>
      <%= form.text_field :city %>
    </div>

    <div class="form-group">
      <%= form.label :state, "Estado" %>
      <%= form.text_field :state %>
    </div>

  </div>

  <div class="profile-actions">

    <%= form.submit "Salvar alterações",
                    class: "submit-answer-button" %>

    <%= link_to "Voltar",
                users_profile_path,
                class: "action-button" %>

  </div>

<% end %>


  </div>

</div>
