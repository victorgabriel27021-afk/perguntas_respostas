<div class="admin-dashboard-page">

  <div class="admin-dashboard-header">
    <h1><%= t("admin_users.title") %></h1>
    <p><%= t("admin_users.subtitle") %></p>
  </div>

  <div class="admin-users-card">

<div class="admin-users-header">
  <strong><%= t("admin_users.user") %></strong>
  <strong><%= t("admin_users.email") %></strong>
  <strong><%= t("admin_users.type") %></strong>
  <strong><%= t("admin_users.actions") %></strong>
</div>

<% @users.each do |user| %>

  <div class="admin-user-row">

    <div>
      <strong>
        <%= link_to(
              "#{user.first_name.presence || t('admin_users.no_name')} #{user.last_name}".strip,
              admin_user_path(user),
              class: "admin-user-name"
            ) %>
      </strong>
    </div>

    <div>
      <%= user.email %>
    </div>

    <div>
      <% if user.admin? %>
        <span class="admin-badge">
          <%= t("admin_users.administrator") %>
        </span>
      <% else %>
        <span class="user-badge">
          <%= t("admin_users.regular_user") %>
        </span>
      <% end %>
    </div>

    <div>

      <%= link_to t("admin_users.view"),
                  admin_user_path(user),
                  class: "admin-action-button" %>

      <%= link_to t("admin_users.edit"),
                  edit_admin_user_path(user),
                  class: "admin-action-button" %>

      <%= link_to user.admin? ?
                    t("admin_users.remove_admin") :
                    t("admin_users.make_admin"),
                  admin_toggle_admin_user_path(user),
                  data: {
                    turbo_method: :patch,
                    turbo_confirm: user.admin? ?
                      t("admin_users.confirm_remove_admin") :
                      t("admin_users.confirm_make_admin")
                  },
                  class: "admin-action-button" %>

      <% unless user == current_user %>

        <%= link_to t("admin_users.delete"),
                    admin_user_path(user),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: t("admin_users.confirm_delete")
                    },
                    class: "admin-action-button delete-button" %>

      <% end %>

    </div>

  </div>

<% end %>

  </div>

</div>
