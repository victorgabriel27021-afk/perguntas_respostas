<div class="admin-dashboard-page">

  <div class="admin-dashboard-header">
    <div>
      <h1><%= t("admin_user.details_title") %></h1>
      <p><%= t("admin_user.details_subtitle") %></p>
    </div>
  </div>

  <div class="admin-users-card">

<div class="admin-user-details">

  <div>
    <strong><%= t("admin_user.name") %></strong>
    <p>
      <%= @user.first_name.presence || t("admin_user.no_name") %>
      <%= @user.last_name %>
    </p>
  </div>

  <div>
    <strong><%= t("admin_user.email") %></strong>
    <p><%= @user.email %></p>
  </div>

  <div>
    <strong><%= t("admin_user.account_type") %></strong>
    <p>
      <% if @user.admin? %>
        <span class="admin-badge">
          <%= t("admin_user.administrator") %>
        </span>
      <% else %>
        <span class="user-badge">
          <%= t("admin_user.regular_user") %>
        </span>
      <% end %>
    </p>
  </div>

  <div>
    <strong><%= t("admin_user.registered_at") %></strong>
    <p><%= @user.created_at.strftime("%d/%m/%Y às %H:%M") %></p>
  </div>

</div>

<div class="question-actions">

  <%= link_to t("admin_user.back"),
              admin_users_path,
              class: "action-button" %>

</div>

  </div>

</div>
