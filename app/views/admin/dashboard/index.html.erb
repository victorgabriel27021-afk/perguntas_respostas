<div class="admin-dashboard-page">

  <div class="admin-dashboard-header">
    <h1><%= t("admin_dashboard.title") %></h1>
    <p><%= t("admin_dashboard.subtitle") %></p>
  </div>

  <div class="admin-dashboard-grid">

<div class="admin-dashboard-card">
  <h2>👥</h2>

  <div class="admin-dashboard-number">
    <%= @users_count %>
  </div>

  <p><%= t("admin_dashboard.users_count") %></p>
</div>

<div class="admin-dashboard-card">
  <h2>❓</h2>

  <div class="admin-dashboard-number">
    <%= Question.count %>
  </div>

  <p><%= t("admin_dashboard.questions_count") %></p>
</div>

<div class="admin-dashboard-card">
  <h2>💬</h2>

  <div class="admin-dashboard-number">
    <%= Answer.count %>
  </div>

  <p><%= t("admin_dashboard.answers_count") %></p>
</div>

<div class="admin-dashboard-card">

  <h2>📂</h2>

  <div class="admin-dashboard-number">
    <%= Category.count %>
  </div>

  <p>
    <%= link_to t("admin_dashboard.categories"),
                admin_categories_path,
                class: "admin-dashboard-link" %>
  </p>

</div>

  </div>

</div>
