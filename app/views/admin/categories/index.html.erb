<div class="admin-dashboard-page">

  <div class="admin-dashboard-header">

<div>
  <h1><%= t("admin_categories.title") %></h1>
  <p><%= t("admin_categories.subtitle") %></p>
</div>

<%= link_to t("admin_categories.new_category"),
            new_admin_category_path,
            class: "dashboard-button" %>

  </div>

  <div class="admin-users-card">

<div class="admin-users-header">
  <strong><%= t("admin_categories.category") %></strong>
  <strong><%= t("admin_categories.questions") %></strong>
  <strong><%= t("admin_categories.actions") %></strong>
</div>

<% @categories.each do |category| %>

  <div class="admin-user-row">

    <div>
      <strong>
        <%= category.name %>
      </strong>
    </div>

    <div>
      <%= category.questions.count %>
    </div>

    <div>

      <%= link_to t("admin_categories.edit"),
            edit_admin_category_path(category),
            class: "admin-action-button" %>

      <%= link_to t("admin_categories.delete"),
                  admin_category_path(category),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: t("admin_categories.confirm_delete")
                  },
                  class: "admin-action-button delete-button" %>

    </div>

  </div>

<% end %>

  </div>

</div>
