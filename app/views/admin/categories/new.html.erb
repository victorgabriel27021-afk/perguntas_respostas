<div class="admin-dashboard-page">

  <div class="admin-dashboard-header">
    <h1><%= t("admin_new_category.title") %></h1>
    <p><%= t("admin_new_category.subtitle") %></p>
  </div>

  <div class="admin-users-card">

<%= form_with model: @category,
              url: admin_categories_path,
              method: :post do |form| %>

  <div class="form-group">
    <%= form.label :name, t("admin_new_category.name") %>

    <%= form.text_field :name,
        placeholder: t("admin_new_category.placeholder") %>
  </div>

  <div class="question-actions">

    <%= form.submit t("admin_new_category.create"),
                    class: "submit-answer-button" %>

    <%= link_to t("admin_new_category.cancel"),
                admin_categories_path,
                class: "action-button" %>

  </div>

<% end %>

  </div>

</div>
