<div class="admin-dashboard-page">

  <div class="admin-dashboard-header">
    <div>
      <h1><%= t("admin_edit_category.title") %></h1>
      <p><%= t("admin_edit_category.subtitle") %></p>
    </div>
  </div>

  <div class="admin-users-card">

<%= form_with model: @category,
              url: admin_category_path(@category),
              method: :patch do |form| %>

  <div class="form-group">
    <%= form.label :name, t("admin_edit_category.name") %>

    <%= form.text_field :name,
        placeholder: t("admin_edit_category.placeholder") %>
  </div>

  <div class="question-actions">

    <%= form.submit t("admin_edit_category.save"),
                    class: "submit-answer-button" %>

    <%= link_to t("admin_edit_category.cancel"),
                admin_categories_path,
                class: "action-button" %>

  </div>

<% end %>

  </div>

</div>
