<!DOCTYPE html>

<html>
  <head>
    <title><%= content_for(:title) || "Perguntas Respostas" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <div data-controller="sidebar">

      <button type="button"
              class="sidebar-toggle"
              data-action="click->sidebar#toggle">
        ☰
      </button>

      <aside class="sidebar">

  <h2>Askly</h2>

<%= link_to "🏠 Perguntas", questions_path %>

<%= link_to "📊 Dashboard", dashboard_path %>

<%= link_to "👤 Meu perfil", users_profile_path %>

<%= link_to "⭐ Minha reputação", users_profile_path %>

<%= link_to "❓ Minhas perguntas", my_questions_path %>

<%= link_to "💬 Minhas respostas", questions_path %>

<%= link_to "🏆 Ranking", ranking_path %>

  <div class="sidebar-divider"></div>

  <%= link_to "⚙️ Configurações", users_profile_path %>

  <% if user_signed_in? %>
    <%= link_to "🚪 Sair",
                destroy_user_session_path,
                data: { turbo_method: :delete } %>
  <% end %>

</aside>

    </div>

    <nav class="navbar">
      <div class="navbar-container">

        <%= link_to "Askly", root_path, class: "navbar-logo" %>

        <form class="navbar-search" action="<%= questions_path %>" method="get">
  <input
    type="text"
    name="search"
    placeholder="Pesquisar perguntas..."
    value="<%= params[:search] %>"
  >

  <button type="submit">🔍</button>
</form>

        <div class="navbar-links">

          <%= link_to "🇧🇷 PT-BR",
            change_locale_path("pt-BR"),
            class: "navbar-link" %>

            <%= link_to "🇺🇸 EN",
            change_locale_path("en"),
            class: "navbar-link" %>

          <% if user_signed_in? %>

  <%= link_to notifications_path,
            class: "navbar-link notification-bell" do %>
  🔔

  <% unread_count = current_user.notifications.where(read: false).or(current_user.notifications.where(read: nil)).count %>

  <% if unread_count > 0 %>
    <span class="notification-count">
      <%= unread_count %>
    </span>
  <% end %>
<% end %>

  <span class="navbar-user">
              <%= current_user.first_name.presence || current_user.email %>
            </span>

            <% if current_user.admin? %>

              <%= link_to "Painel Admin",
                          admin_dashboard_path,
                          class: "navbar-button" %>

            <% end %>

            <%= link_to "Sair",
                        destroy_user_session_path,
                        data: { turbo_method: :delete },
                        class: "navbar-button" %>

          <% else %>

            <%= link_to "Entrar",
                        new_user_session_path,
                        class: "navbar-link" %>

            <%= link_to "Cadastrar",
                        new_user_registration_path,
                        class: "navbar-button" %>

          <% end %>

        </div>

      </div>
    </nav>

    <%= yield %>

  </body>
</html>