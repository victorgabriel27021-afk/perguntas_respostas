<!DOCTYPE html>

<html>
  <head>
    <title><%= t("admin.title") %></title>

<meta name="viewport" content="width=device-width,initial-scale=1">

<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= stylesheet_link_tag "application",
                        media: "all",
                        "data-turbo-track": "reload" %>

<%= javascript_importmap_tags %>

  </head>

  <body>

<nav class="navbar">
  <div class="navbar-container">

    <%= link_to "Askly Admin",
                admin_dashboard_path,
                class: "navbar-logo" %>

    <div class="navbar-links">

      <%= link_to t("admin.panel"),
                  admin_dashboard_path,
                  class: "navbar-link" %>

      <%= link_to t("admin.users"),
                  admin_users_path,
                  class: "navbar-link" %>

      <%= link_to t("admin.questions"),
                  admin_questions_path,
                  class: "navbar-link" %>

      <%= link_to t("admin.categories"),
                  admin_categories_path,
                  class: "navbar-link" %>

      <%= link_to t("admin.subscriptions"),
                  "#",
                  class: "navbar-link" %>

      <%= link_to t("admin.back_to_site"),
                  root_path,
                  class: "navbar-link" %>

    </div>

  </div>
</nav>

<%= yield %>

  </body>
</html>
