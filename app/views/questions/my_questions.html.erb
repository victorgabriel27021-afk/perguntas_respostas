<div class="questions-page">

  <div class="questions-header">
    <div>
      <h1><%= t("my_questions.title") %></h1>
      <p><%= t("my_questions.subtitle") %></p>
    </div>

    <%= link_to t("my_questions.new_question"),
                new_question_path,
                class: "new-question-button" %>
  </div>

  <% if @questions.any? %>

    <ul class="questions-list">

      <% @questions.each do |question| %>

        <li class="question-card">

          <%= link_to question.description,
                      question_path(question),
                      class: "question-title" %>

          <div class="question-info">

            <span class="question-category">
              <%= question.category.name %>
            </span>

            <span>
              <%= t("my_questions.created_by_you") %>
            </span>

          </div>

          <%= link_to t("my_questions.view_question"),
                      question_path(question),
                      class: "view-question" %>

        </li>

      <% end %>

    </ul>

  <% else %>

    <div class="question-card">
      <h2><%= t("my_questions.no_questions") %></h2>

      <p>
        <%= t("my_questions.no_questions_text") %>
      </p>

      <%= link_to t("my_questions.ask_question"),
                  new_question_path,
                  class: "dashboard-button" %>
    </div>

  <% end %>

</div>