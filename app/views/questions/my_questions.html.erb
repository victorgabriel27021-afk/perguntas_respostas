<div class="questions-page">

  <div class="questions-header">
    <div>
      <h1>Minhas perguntas</h1>
      <p>Aqui estão as perguntas que você criou no Askly.</p>
    </div>


<%= link_to "Nova pergunta",
            new_question_path,
            class: "new-question-button" %>


  </div>

<% if @questions.any? %>


<ul class="questions-list">

  <% @questions.each do |question| %>

    <li class="question-card">

      <%= link_to question.description,
                  question_path(question),
                  class: "question-title" %>

      <div class="question-info">

        <span class="question-category">
          <%= question.category.name %>
        </span>

        <span>
          Criada por você
        </span>

      </div>

      <%= link_to "Ver pergunta →",
                  question_path(question),
                  class: "view-question" %>

    </li>

  <% end %>

</ul>


<% else %>


<div class="question-card">
  <h2>Você ainda não fez nenhuma pergunta.</h2>

  <p>
    Faça sua primeira pergunta e comece a participar do Askly.
  </p>

  <%= link_to "Fazer uma pergunta",
              new_question_path,
              class: "dashboard-button" %>
</div>


<% end %>

</div>
