<h1>Perguntas</h1>

<%= link_to "Nova pergunta", new_question_path %>

<ul>
  <% @questions.each do |question| %>
 <li>
  <%= link_to question.description, question_path(question) %>

  <br>

  <small>
    Categoria: <%= question.category&.name || "Sem categoria" %>
    |
    Perguntado por: <%= question.user.email %>
  </small>
</li>
  <% end %>
</ul>