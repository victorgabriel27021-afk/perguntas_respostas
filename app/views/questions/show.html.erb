<div class="question-page">

  <div class="question-detail-card">

<div class="question-detail-header">
  <span class="question-label">Pergunta</span>

  <span class="question-category">
    <%= @question.category&.name || "Sem categoria" %>
  </span>
</div>

<h1>
  <%= @question.description %>
</h1>

<p class="question-author">
  Perguntado por: <strong><%= @question.user.email %></strong>
</p>

<div class="question-actions">
  <%= link_to "Editar",
              edit_question_path(@question),
              class: "action-button" %>

  <%= link_to "Excluir",
              question_path(@question),
              data: {
                turbo_method: :delete,
                turbo_confirm: "Tem certeza que deseja excluir esta pergunta?"
              },
              class: "action-button delete-button" %>

  <%= link_to "Voltar",
              questions_path,
              class: "action-button" %>
</div>


  </div>

  <div class="answers-section">


<h2>Respostas</h2>

<% if @question.answers.any? %>

  <% @question.answers.each do |answer| %>
    <div class="answer-card">

      <p>
        <%= answer.description %>
      </p>

      <small>
  Respondido por: <strong><%= answer.user.email %></strong>
  · 🏆 <%= answer.user.reputation %> pontos
  · 🎖️ <%= answer.user.reputation_level %>
</small>

      <div class="answer-voting" style="display: flex; gap: 10px; align-items: center;">

  <% user_vote = answer.answer_votes.find_by(user: current_user) %>

  <%= button_to "👍",
              vote_answer_path(answer),
              method: :post,
              params: { value: 1 },
              class: "vote-button #{user_vote&.value == 1 ? 'active' : ''}" %>

<span>
  <%= answer.answer_votes.where(value: 1).count %>
</span>

<%= button_to "👎",
              vote_answer_path(answer),
              method: :post,
              params: { value: -1 },
              class: "vote-button #{user_vote&.value == -1 ? 'active' : ''}" %>

<span>
  <%= answer.answer_votes.where(value: -1).count %>
</span>

</div>

    </div>
  <% end %>

<% else %>

  <p class="no-answers">
    Ainda não há respostas para esta pergunta.
  </p>

<% end %>


  </div>

  <div class="answer-form-card">


<h2>Responder pergunta</h2>

<%= form_with model: [@question, Answer.new] do |form| %>

  <div class="form-group">
    <%= form.label :description, "Sua resposta" %>

    <%= form.text_area :description,
                       placeholder: "Escreva sua resposta...",
                       rows: 5 %>
  </div>

  <%= form.submit "Responder", class: "submit-answer-button" %>

<% end %>


  </div>

</div>
