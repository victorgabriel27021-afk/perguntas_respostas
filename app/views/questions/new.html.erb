<div class="question-page">

  <div class="question-detail-card">

    <div class="question-detail-header">
      <span class="question-label">
        <%= t("new_question.label") %>
      </span>
    </div>

    <h1><%= t("new_question.title") %></h1>

    <%= form_with model: @question do |form| %>

      <div class="form-group">
        <%= form.label :description, t("new_question.question") %>

        <%= form.text_area :description,
            rows: 6,
            placeholder: t("new_question.question_placeholder") %>
      </div>

      <div class="form-group">
        <%= form.label :category_id, t("new_question.category") %>

        <%= form.collection_select :category_id,
            @categories,
            :id,
            :name,
            { prompt: t("new_question.select_category") } %>
      </div>

      <div class="question-actions">

        <%= form.submit t("new_question.create"),
            class: "submit-answer-button" %>

        <%= link_to t("new_question.cancel"),
                    questions_path,
                    class: "action-button" %>

      </div>

    <% end %>

  </div>

</div>